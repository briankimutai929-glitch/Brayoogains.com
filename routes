const express = require("express");

const router = express.Router();

// Register
router.post("/register", (req, res) => {
    res.json({
        success: true,
        message: "Register endpoint is working."
    });
});

// Login
router.post("/login", (req, res) => {
    res.json({
        success: true,
        message: "Login endpoint is working."
    });
});

module.exports = router;